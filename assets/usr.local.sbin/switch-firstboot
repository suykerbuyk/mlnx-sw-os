#!/bin/sh
# Switch first-boot identity. Installed to /usr/local/sbin/switch-firstboot and
# run by switch-firstboot.service, which is conditioned on the ABSENCE of the
# stamp this script writes as its last act.
#
# 🔴 THE STAMP REPLACED ConditionFirstBoot=yes ON 2026-08-04, after the
# artifact's first ever boot shipped it unreachable: ConditionFirstBoot tests
# /run/systemd/first-boot, PID 1 never created it, and this script never ran.
# The unit file carries the full measurement. Two properties matter here:
# the stamp is written LAST and only on success, so a failed run RETRIES on the
# next boot; and everything below is idempotent, so a retry is harmless.
#
# Scope is IDENTITY ONLY:
#   - hostname, derived from DMI (AD-5: no per-switch identity baked into the
#     artifact, and /sys/class/dmi/id needs no extra package -- no dmidecode,
#     no smbios-utils)
#   - SSH host keys, which generalization deleted -- delegated to
#     /usr/local/sbin/switch-sshd-keygen, which switch-sshd-keygen.service ALSO
#     runs on its own. One implementation, two independent triggers, because a
#     single conditioned unit being the sole custodian of remote access is the
#     defect that shipped.
#   - /var/lib/dbus/machine-id, if this distro still wants one
#
# It does NOT grow anything (systemd-repart + x-systemd.growfs own that) and it
# does NOT touch the network (the shipped systemd-networkd units are the sole
# authority -- there is no cloud-init and no netplan on this image).
#
# POSIX sh, no bashisms, no distro-specific tooling: it has to run unchanged if
# the base is ever swapped from Debian to Arch.
set -eu

STAMP="${STAMP:-/var/lib/switch-firstboot.stamp}"
KEYGEN="${KEYGEN:-/usr/local/sbin/switch-sshd-keygen}"

log() { printf 'switch-firstboot: %s\n' "$*"; }

# Lowercase, keep [a-z0-9-], squeeze and trim separators. printf without a
# newline, because `tr -c` would otherwise translate the newline too.
sanitize() { printf '%s' "${1:-}" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9-' '-' \
	| sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//'; }

dmi() { [ -r "/sys/class/dmi/id/$1" ] && cat "/sys/class/dmi/id/$1" 2>/dev/null || true; }

# DMI serials are famously junk on generic hardware and in QEMU. Reject the
# known placeholders rather than minting a hostname out of one.
usable_serial() {
	case "$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')" in
	''|none|na|n/a|unknown|'not specified'|'not available'|default*|'to be filled by o.e.m.'|0|0123456789|system*)
		return 1 ;;
	esac
	[ "${#1}" -ge 4 ]
}

# ---------------------------------------------------------------- hostname
#
# Derived name: mlnx-<sanitized DMI product_name>-<last 8 of a usable serial>.
#
# The serial is taken from the first rung of this chain that yields something
# usable -- "usable" meaning not one of the known placeholders ("Not Specified",
# "To Be Filled By O.E.M.", Arch's "Default string" and friends):
#
#   1. DMI product_serial        the system serial; what the fleet's switches carry
#   2. DMI board_serial          NEW 2026-08-04. Observed on Arch hardware: the
#                                PRODUCT serial is a placeholder while the
#                                BASEBOARD serial is valid. Same file tree, no
#                                extra package, so the rung is free.
#   3. first 8 of machine-id     already unique per machine, generated from the
#                                kernel's RNG. 🔴 NOT a timestamp: two switches
#                                imaged and booted in the same second collide on
#                                a timestamp and cannot collide on machine-id.
#   4. the literal "unknown"     a last resort that is still a NAME. An empty
#                                /etc/hostname is what leaves a switch calling
#                                itself localhost, and every switch on the
#                                segment answering to localhost is worse than
#                                two answering to the same wrong name.
#
# 🔴 RULED, do not "fix" this: it does NOT reproduce the fleet's existing
# mlnx-2410-cameo / mlnx-2700-cameo convention, and that divergence is a
# DECISION, not an oversight. `cameo` is a site name and is nowhere in DMI. The
# only way to bake it in would be a build-time SITE= variable, which means one
# artifact per site and breaks AD-5's one-artifact rule. The supported way to
# apply a site convention is to pre-seed /etc/hostname before first boot, which
# the guard below honours.
set_hostname() {
	# An operator who pre-seeded /etc/hostname before first boot outranks DMI.
	if [ -s /etc/hostname ]; then
		cur=$(tr -d ' \t\n' < /etc/hostname)
		case "$cur" in
		''|localhost|localhost.localdomain) ;;
		*) log "hostname already set to '$cur' -- leaving it alone"
		   ensure_hosts "$cur"; return 0 ;;
		esac
	fi

	model=$(sanitize "$(dmi product_name)")
	[ -n "$model" ] || model=switch

	ser=$(dmi product_serial)
	src=product_serial
	if ! usable_serial "$ser"; then
		log "DMI product_serial unusable ('$ser') -- trying board_serial"
		ser=$(dmi board_serial)
		src=board_serial
	fi

	if usable_serial "$ser"; then
		# 🔴 printf, NOT the bare pipeline. `sanitize ... | tail -c 8` counts
		# sed's trailing NEWLINE as one of the eight bytes and yields SEVEN
		# characters -- a silent off-by-one against this file's own
		# documented "last 8". Re-printing without a newline makes the
		# count mean what it says.
		tag=$(printf '%s' "$(sanitize "$ser")" | tail -c 8)
		log "hostname tag from DMI $src"
	elif [ -s /etc/machine-id ]; then
		# machine-id is already generated by systemd at this point in the
		# boot, and it is unique per machine -- which is exactly the
		# property a hostname needs when both DMI serials are junk.
		tag=$(cut -c1-8 /etc/machine-id)
		log "no usable DMI serial (board_serial '$ser' too) -- falling back to machine-id"
	else
		tag=unknown
		log "WARNING: no usable DMI serial and no machine-id; hostname is not unique"
	fi
	tag=$(sanitize "$tag")
	[ -n "$tag" ] || tag=unknown

	name=$(printf 'mlnx-%s-%s' "$model" "$tag" | cut -c1-63)
	name=$(sanitize "$name")
	# Rung 4. Unreachable with the guards above -- the literal "mlnx-" prefix
	# alone survives sanitize -- and kept anyway, because the ONE outcome this
	# function must never produce is an empty /etc/hostname. That is what left
	# the 2026-08-04 artifact calling itself localhost.
	[ -n "$name" ] || name=mlnx-switch-unknown

	printf '%s\n' "$name" > /etc/hostname
	if command -v hostnamectl >/dev/null 2>&1 \
	   && hostnamectl set-hostname "$name" 2>/dev/null; then
		log "hostname set to '$name' (hostnamectl)"
	elif printf '%s' "$name" > /proc/sys/kernel/hostname 2>/dev/null; then
		log "hostname set to '$name' (/proc/sys/kernel/hostname)"
	else
		log "WARNING: /etc/hostname written as '$name' but the live hostname could not be set"
	fi
	ensure_hosts "$name"
}

# Debian convention: 127.0.1.1 carries the FQDN-less hostname so that a
# hostname lookup succeeds with no DNS and no DHCP lease.
ensure_hosts() {
	[ -f /etc/hosts ] || return 0
	n="$1"
	tmp=$(mktemp /etc/hosts.XXXXXX)
	grep -v '^127\.0\.1\.1[[:space:]]' /etc/hosts > "$tmp" || true
	printf '127.0.1.1\t%s\n' "$n" >> "$tmp"
	chmod 0644 "$tmp"
	mv "$tmp" /etc/hosts
}

# ---------------------------------------------------------------- ssh keys
#
# 🔴 DELEGATED, not inlined, and that is the point. The same script is run
# independently by switch-sshd-keygen.service, whose condition is the ABSENCE of
# the host key rather than anything about first boots. Two triggers, one
# implementation: if this unit is ever skipped again for any reason, the switch
# still comes up reachable -- with a generic hostname, which is a remote fix
# rather than a site visit.
#
# ⚠ ORDERING IS LOAD-BEARING. This runs AFTER set_hostname so the key's comment
# carries the derived name; reorder these two calls and the fleet's host keys
# are all commented "switch". The keygen script re-reads /etc/hostname itself,
# so the coupling is one-way and the standalone unit needs no ordering fix.
set_ssh_host_keys() {
	[ -x "$KEYGEN" ] || {
		log "WARNING: $KEYGEN is missing -- host keys NOT regenerated here. \
switch-sshd-keygen.service owns the same job and is the reason this is a \
warning rather than a failure."; return 0; }
	"$KEYGEN"
}

# ---------------------------------------------------------------- dbus id
set_dbus_machine_id() {
	[ -d /var/lib/dbus ] || return 0
	[ -e /var/lib/dbus/machine-id ] && return 0
	ln -s /etc/machine-id /var/lib/dbus/machine-id
	log "linked /var/lib/dbus/machine-id -> /etc/machine-id"
}

set_hostname
set_ssh_host_keys
set_dbus_machine_id

# ---------------------------------------------------------------- the stamp
# 🔴 LAST, AND ONLY ON SUCCESS. `set -e` means any failure above aborts before
# this line, the stamp is not written, and the unit's ConditionPathExists=! is
# still true on the next boot -- so the run retries instead of being silently
# consumed. ConditionFirstBoot=yes could not do that: it was true exactly once,
# whether or not anything had worked.
#
# ⚠ scripts/stage-generalize.sh's do_finish removes this file before export.
# The build guest reboots once during the build, which fires this unit; without
# that removal the stamp ships inside the image and the artifact's first boot
# skips identity setup permanently -- the same defect this file exists to fix.
mkdir -p "$(dirname "$STAMP")"
printf 'hostname=%s\ncompleted=1\n' "$(cat /etc/hostname 2>/dev/null || echo unknown)" > "$STAMP"
chmod 0644 "$STAMP"
log "stamp written: $STAMP"
log "done"
