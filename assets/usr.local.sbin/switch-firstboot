#!/bin/sh
# Switch first-boot identity. Installed to /usr/local/sbin/switch-firstboot and
# run once by switch-firstboot.service (ConditionFirstBoot=yes).
#
# Scope is IDENTITY ONLY:
#   - hostname, derived from DMI (AD-5: no per-switch identity baked into the
#     artifact, and /sys/class/dmi/id needs no extra package -- no dmidecode,
#     no smbios-utils)
#   - SSH host keys, which generalization deleted
#   - /var/lib/dbus/machine-id, if this distro still wants one
#
# It does NOT grow anything (systemd-repart + x-systemd.growfs own that) and it
# does NOT touch the network (the shipped systemd-networkd units are the sole
# authority -- there is no cloud-init and no netplan on this image).
#
# POSIX sh, no bashisms, no distro-specific tooling: it has to run unchanged if
# the base is ever swapped from Debian to Arch.
set -eu

log() { printf 'switch-firstboot: %s\n' "$*"; }

# Lowercase, keep [a-z0-9-], squeeze and trim separators. printf without a
# newline, because `tr -c` would otherwise translate the newline too.
sanitize() { printf '%s' "${1:-}" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9-' '-' \
	| sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//'; }

dmi() { [ -r "/sys/class/dmi/id/$1" ] && cat "/sys/class/dmi/id/$1" 2>/dev/null || true; }

# DMI serials are famously junk on generic hardware and in QEMU. Reject the
# known placeholders rather than minting a hostname out of one.
usable_serial() {
	case "$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')" in
	''|none|na|n/a|unknown|'not specified'|'not available'|default*|'to be filled by o.e.m.'|0|0123456789|system*)
		return 1 ;;
	esac
	[ "${#1}" -ge 4 ]
}

# ---------------------------------------------------------------- hostname
#
# Derived name: mlnx-<sanitized DMI product_name>-<last 8 of DMI product_serial>,
# falling back to the first 8 of machine-id when the serial is one of the known
# placeholders ("Not Specified", "To Be Filled By O.E.M." and friends).
#
# 🔴 RULED, do not "fix" this: it does NOT reproduce the fleet's existing
# mlnx-2410-cameo / mlnx-2700-cameo convention, and that divergence is a
# DECISION, not an oversight. `cameo` is a site name and is nowhere in DMI. The
# only way to bake it in would be a build-time SITE= variable, which means one
# artifact per site and breaks AD-5's one-artifact rule. The supported way to
# apply a site convention is to pre-seed /etc/hostname before first boot, which
# the guard below honours.
set_hostname() {
	# An operator who pre-seeded /etc/hostname before first boot outranks DMI.
	if [ -s /etc/hostname ]; then
		cur=$(tr -d ' \t\n' < /etc/hostname)
		case "$cur" in
		''|localhost|localhost.localdomain) ;;
		*) log "hostname already set to '$cur' -- leaving it alone"
		   ensure_hosts "$cur"; return 0 ;;
		esac
	fi

	model=$(sanitize "$(dmi product_name)")
	[ -n "$model" ] || model=switch

	ser=$(dmi product_serial)
	if usable_serial "$ser"; then
		tag=$(sanitize "$ser" | tail -c 8)
	elif [ -s /etc/machine-id ]; then
		# machine-id is already generated by systemd at this point in the
		# boot, and it is unique per machine -- which is exactly the
		# property a hostname needs when the DMI serial is junk.
		tag=$(cut -c1-8 /etc/machine-id)
		log "DMI product_serial unusable ('$ser') -- falling back to machine-id"
	else
		tag=unknown
		log "WARNING: no usable DMI serial and no machine-id; hostname is not unique"
	fi
	tag=$(sanitize "$tag")
	[ -n "$tag" ] || tag=unknown

	name=$(printf 'mlnx-%s-%s' "$model" "$tag" | cut -c1-63)
	name=$(sanitize "$name")

	printf '%s\n' "$name" > /etc/hostname
	if command -v hostnamectl >/dev/null 2>&1 \
	   && hostnamectl set-hostname "$name" 2>/dev/null; then
		log "hostname set to '$name' (hostnamectl)"
	elif printf '%s' "$name" > /proc/sys/kernel/hostname 2>/dev/null; then
		log "hostname set to '$name' (/proc/sys/kernel/hostname)"
	else
		log "WARNING: /etc/hostname written as '$name' but the live hostname could not be set"
	fi
	ensure_hosts "$name"
}

# Debian convention: 127.0.1.1 carries the FQDN-less hostname so that a
# hostname lookup succeeds with no DNS and no DHCP lease.
ensure_hosts() {
	[ -f /etc/hosts ] || return 0
	n="$1"
	tmp=$(mktemp /etc/hosts.XXXXXX)
	grep -v '^127\.0\.1\.1[[:space:]]' /etc/hosts > "$tmp" || true
	printf '127.0.1.1\t%s\n' "$n" >> "$tmp"
	chmod 0644 "$tmp"
	mv "$tmp" /etc/hosts
}

# ---------------------------------------------------------------- ssh keys
set_ssh_host_keys() {
	command -v ssh-keygen >/dev/null 2>&1 || {
		log "WARNING: no ssh-keygen -- host keys NOT regenerated"; return 0; }
	# -A generates only the key types that are missing, so this is idempotent
	# and cannot clobber a key an operator installed deliberately.
	ssh-keygen -A
	set -- /etc/ssh/ssh_host_*_key
	[ -e "$1" ] || { log "ERROR: no SSH host keys after ssh-keygen -A"; return 1; }
	log "SSH host keys present: $(ls /etc/ssh/ssh_host_*_key 2>/dev/null | wc -l)"
}

# ---------------------------------------------------------------- dbus id
set_dbus_machine_id() {
	[ -d /var/lib/dbus ] || return 0
	[ -e /var/lib/dbus/machine-id ] && return 0
	ln -s /etc/machine-id /var/lib/dbus/machine-id
	log "linked /var/lib/dbus/machine-id -> /etc/machine-id"
}

set_hostname
set_ssh_host_keys
set_dbus_machine_id
log "done"
