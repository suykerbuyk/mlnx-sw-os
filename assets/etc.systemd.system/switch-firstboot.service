# Identity at first boot -- and ONLY identity.
#
# This unit does NOT own growth. The root partition is grown by
# systemd-repart (/etc/repart.d/50-root.conf) and the filesystem by
# x-systemd.growfs on the root fstab entry; both are systemd-native on Debian
# and on Arch, which is the whole reason they were chosen over
# cloud-initramfs-growroot.
#
# 🔴 ConditionFirstBoot=yes WAS WRONG AND IS DELETED, 2026-08-04, after the
# artifact's first ever boot shipped it unreachable. The old comment here
# asserted that ConditionFirstBoot is true exactly when /etc/machine-id was
# unpopulated at boot. IT IS NOT. It tests one thing -- whether PID 1 created
# /run/systemd/first-boot -- and on this artifact PID 1 never did, even though
# stage-generalize truncates machine-id exactly as machine-id(5) documents.
# Measured in the guest:
#
#   DIAG first-boot-flag: ABSENT
#   DIAG fb-ConditionResult: no
#   systemd[1]: switch-firstboot.service ... skipped, unmet condition check
#               ConditionFirstBoot=yes
#
# The boot logs "Installed transient /etc/machine-id file" and then runs
# systemd-machine-id-commit -- the transient path, taken because / is still ro
# at PID 1 (the kernel command line carries `ro`, and /etc becomes writable only
# after systemd-remount-fs). Strongly indicated, deliberately NOT relied upon:
# the replacement condition does not care why.
#
# 🔴 The consequence chain is why this unit is worth this much comment. No
# first boot -> no host keys regenerated -> `sshd -t` fails -> ssh.service gives
# up after five tries -> a switch that boots correctly in every other respect
# and cannot be logged into.
#
# ConditionPathExists=!<stamp> is OWNED BY THIS PROJECT and asks a question with
# one answer: has this script already completed successfully on this machine?
# The script writes the stamp LAST, and only on success, so a failed run RETRIES
# on the next boot instead of never trying again -- which ConditionFirstBoot
# could not do, by construction. That is the same reasoning switch-swapfile.service
# already records. A unit whose Condition fails is reported SKIPPED, not failed,
# so `systemctl --failed` stays empty with nothing muted: the project's rule is
# condition units, never allowlist them.
#
# ⚠ THE STAMP MUST BE REMOVED BEFORE EXPORT. The build guest reboots once
# between `prepare` and `verify`, which fires this unit and writes the stamp
# INSIDE the image being built. scripts/stage-generalize.sh's do_finish removes
# it there, on the line below `rm -f /etc/hostname`, exactly as it already
# removes a /swapfile a build-time reboot may have created; and
# scripts/boot-test.sh's offline tier asserts the stamp is absent from the
# finished artifact, so the trap cannot come back unnoticed.
#
# Ordering: before sshd (it regenerates the host keys sshd needs) and before
# systemd-networkd (so DHCP does not announce the pre-generalize hostname).
# Ordering edges naming units that do not exist on a given distro -- ssh.service
# on Arch, sshd.service on Debian -- are inert, which is what makes one file
# work on both.
#
# 🔴 DefaultDependencies=no IS LOAD-BEARING, added 2026-08-03 after a real boot.
# With the default dependencies systemd adds an implicit After=basic.target,
# and this unit also declares Before=systemd-networkd.service -- but networkd is
# needed BEFORE basic.target, so the two edges close a loop. Measured:
#
#   sysinit.target: Found ordering cycle on cloud-init-network.service/start
#   sysinit.target: Found dependency on systemd-networkd-wait-online.service/start
#   sysinit.target: Found dependency on systemd-networkd.service/start
#   sysinit.target: Found dependency on switch-firstboot.service/start
#   sysinit.target: Found dependency on basic.target/start
#   ...
#   Job cloud-init-network.service/start DELETED to break ordering cycle
#
# 🔴 The damage is not the cycle, it is the RESOLUTION: systemd breaks a cycle by
# DELETING A JOB, and which job it picks is not something this project controls
# or can predict. Here it deleted cloud-init-network.service, which is harmless
# only by luck -- cloud-init is purged from the artifact anyway. With that unit
# gone the same loop is still there, and systemd would delete some OTHER job to
# break it, silently, at boot, on a switch. A boot that quietly drops
# systemd-networkd is a switch that never comes back.
#
# So the implicit ordering is dropped and the edges this unit actually needs are
# stated explicitly. That is the same shape switch-growroot.service already uses,
# and for the same reason.
[Unit]
Description=Switch first-boot identity (hostname, SSH host keys, machine-id)
Documentation=man:machine-id(5) man:ssh-keygen(1)
DefaultDependencies=no
ConditionPathExists=!/var/lib/switch-firstboot.stamp
After=systemd-remount-fs.service
Before=systemd-networkd.service systemd-user-sessions.service ssh.service sshd.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/switch-firstboot

[Install]
WantedBy=multi-user.target
