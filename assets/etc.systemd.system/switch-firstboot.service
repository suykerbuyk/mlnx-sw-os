# Identity at first boot -- and ONLY identity.
#
# This unit does NOT own growth. The root partition is grown by
# systemd-repart (/etc/repart.d/50-root.conf) and the filesystem by
# x-systemd.growfs on the root fstab entry; both are systemd-native on Debian
# and on Arch, which is the whole reason they were chosen over
# cloud-initramfs-growroot.
#
# ConditionFirstBoot=yes is true exactly when /etc/machine-id was unpopulated
# at boot -- which is precisely the state scripts/stage-generalize.sh leaves the
# artifact in (machine-id truncated to an empty file, per machine-id(5)). So the
# unit fires once, on the first boot after imaging, and is SKIPPED (not failed)
# on every boot after that. A skipped Condition* keeps `systemctl --failed`
# clean with nothing muted, which is the project's rule: condition units, never
# allowlist them.
#
# Ordering: before sshd (it regenerates the host keys sshd needs) and before
# systemd-networkd (so DHCP does not announce the pre-generalize hostname).
# Ordering edges naming units that do not exist on a given distro -- ssh.service
# on Arch, sshd.service on Debian -- are inert, which is what makes one file
# work on both.
#
# 🔴 DefaultDependencies=no IS LOAD-BEARING, added 2026-08-03 after a real boot.
# With the default dependencies systemd adds an implicit After=basic.target,
# and this unit also declares Before=systemd-networkd.service -- but networkd is
# needed BEFORE basic.target, so the two edges close a loop. Measured:
#
#   sysinit.target: Found ordering cycle on cloud-init-network.service/start
#   sysinit.target: Found dependency on systemd-networkd-wait-online.service/start
#   sysinit.target: Found dependency on systemd-networkd.service/start
#   sysinit.target: Found dependency on switch-firstboot.service/start
#   sysinit.target: Found dependency on basic.target/start
#   ...
#   Job cloud-init-network.service/start DELETED to break ordering cycle
#
# 🔴 The damage is not the cycle, it is the RESOLUTION: systemd breaks a cycle by
# DELETING A JOB, and which job it picks is not something this project controls
# or can predict. Here it deleted cloud-init-network.service, which is harmless
# only by luck -- cloud-init is purged from the artifact anyway. With that unit
# gone the same loop is still there, and systemd would delete some OTHER job to
# break it, silently, at boot, on a switch. A boot that quietly drops
# systemd-networkd is a switch that never comes back.
#
# So the implicit ordering is dropped and the edges this unit actually needs are
# stated explicitly. That is the same shape switch-growroot.service already uses,
# and for the same reason.
[Unit]
Description=Switch first-boot identity (hostname, SSH host keys, machine-id)
Documentation=man:machine-id(5) man:ssh-keygen(1)
DefaultDependencies=no
ConditionFirstBoot=yes
After=systemd-remount-fs.service
Before=systemd-networkd.service systemd-user-sessions.service ssh.service sshd.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/switch-firstboot

[Install]
WantedBy=multi-user.target
